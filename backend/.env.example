# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/voting_system
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/voting_system
MONGO_URI=mongodb://127.0.0.1:27017/voting_system

# Server port
PORT=5000

# JWT secret - use any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Face match sensitivity (lower = stricter). 0.55 - 0.6 is a good default.
FACE_MATCH_THRESHOLD=0.55

# Email (for OTP) - use a Gmail App Password, not your real password
# https://myaccount.google.com/apppasswords
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password

# Admin bootstrap credentials (used once to create the first admin)
ADMIN_EMAIL=admin@votingsystem.com
ADMIN_PASSWORD=Admin@123
